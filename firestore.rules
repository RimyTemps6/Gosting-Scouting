rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function member(t) { return signed() && exists(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid)); }
    function admin(t) { return signed() && get(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid)).data.role == 'admin'; }

    function roomOk(r) {
      let p = r.split('_');
      return signed() && ((p[0] == 't' && p.size() == 2 && exists(/databases/$(database)/documents/teams/$(p[1])/members/$(request.auth.uid)))
        || (p[0] == 'd' && p.size() == 3 && request.auth.uid in p));
    }

    match /profiles/{u} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == u;
    }
    match /dms/{d} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && d.split('_').hasAll(request.resource.data.members);
      allow update: if signed() && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;
      match /messages/{m} {
        allow read: if signed() && request.auth.uid in d.split('_');
        allow create: if signed() && request.auth.uid in d.split('_') && request.resource.data.uid == request.auth.uid;
        allow delete: if signed() && resource.data.uid == request.auth.uid;
      }
    }
    match /rooms/{r}/peers/{u} {
      allow read: if roomOk(r);
      allow write: if roomOk(r) && request.auth.uid == u;
    }
    match /rooms/{r}/signals/{s} {
      allow create: if roomOk(r) && request.resource.data.from == request.auth.uid;
      allow read, delete: if roomOk(r) && resource.data.to == request.auth.uid;
    }

    match /users/{u} {
      allow read, write: if signed() && request.auth.uid == u;
    }
    match /teams/{t} {
      allow get: if signed();
      allow create: if signed() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if admin(t);

      match /members/{m} {
        allow read: if signed() && (request.auth.uid == m || member(t));
        allow create: if signed() && request.auth.uid == m
                      && get(/databases/$(database)/documents/teams/$(t)).data.ownerId == request.auth.uid
                      || admin(t);
        allow update: if admin(t) || (signed() && request.auth.uid == m && request.resource.data.role == resource.data.role);
        allow delete: if admin(t) || (signed() && request.auth.uid == m);
      }
      match /requests/{r} {
        allow create: if signed() && request.auth.uid == r;
        allow read: if signed() && (request.auth.uid == r || admin(t));
        allow delete: if admin(t) || (signed() && request.auth.uid == r);
      }
      match /chat/{m} {
        allow read: if member(t);
        allow create: if member(t) && request.resource.data.uid == request.auth.uid;
        allow delete: if admin(t) || (signed() && resource.data.uid == request.auth.uid);
      }
      match /{coll}/{doc} {
        allow read, write: if member(t) && coll in ['matches','pits','docs','registry','robots'];
      }
    }
  }
}
